{% if dovecot_auth_worker_user | length > 0 %}
service auth-worker {
  user = {{ dovecot_auth_worker_user | to_json }}
}
{% endif %}
{% if dovecot_gssapi_enabled %}
auth_krb5_keytab = {{ dovecot_krb5_keytab | to_json }}
auth_gssapi_hostname = {{ __dovecot_gssapi_hostname | to_json }}
{% endif %}
{% if dovecot_mail_ownership == 'shared' %}
mail_uid = {{ dovecot_mail_uid }}
mail_gid = {{ dovecot_mail_gid }}
{% endif %}
hostname = {{ __dovecot_hostname | to_json }}
postmaster_address = {{ dovecot_postmaster_address | to_json }}
protocols = {{ {'lmtp': dovecot_lmtp_enabled, 'imap': dovecot_imap_enabled, 'sieve': dovecot_managesieve_enabled} | dict2items | selectattr('value') | map(attribute='key') | join(' ') }}
listen = {{ dovecot_listen | join(', ') | to_json }}
auth_mechanisms = plain login{{ ' gssapi' if dovecot_gssapi_enabled else '' }}
first_valid_uid = {{ dovecot_first_valid_uid if dovecot_mail_ownership == 'per_user' else dovecot_mail_uid }}
last_valid_uid = {{ dovecot_last_valid_uid if dovecot_mail_ownership == 'per_user' else dovecot_mail_uid }}
first_valid_gid = {{ dovecot_first_valid_gid if dovecot_mail_ownership == 'per_user' else dovecot_mail_gid }}
last_valid_gid = {{ dovecot_last_valid_gid if dovecot_mail_ownership == 'per_user' else dovecot_mail_gid }}
mail_privileged_group =
mail_access_groups = {{ __dovecot_access_groups | join(' ') }}
mail_full_filesystem_access = no

recipient_delimiter = {{ dovecot_recipient_delimiter | to_json }}
lda_mailbox_autocreate = {{ dovecot_lda_mailbox_autocreate | ternary('yes', 'no') }}
{% if dovecot_submission_host %}
submission_host = {{ dovecot_submission_host | to_json }}
{% endif %}
{% if dovecot_auth_cache_size %}
auth_cache_size = {{ dovecot_auth_cache_size }}B
auth_cache_ttl = {{ dovecot_auth_cache_ttl }}s
auth_cache_negative_ttl = {{ dovecot_auth_cache_negative_ttl }}s
{% endif %}
{% for __dovecot_plugin in (dovecot_mail_plugins + (['quota'] if dovecot_quota_enabled else [])) | unique %}
mail_plugins {
  {{ __dovecot_plugin }} = yes
}
{% endfor %}
