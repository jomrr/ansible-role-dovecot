{% if dovecot_sieve_enabled %}
{% if dovecot_lmtp_enabled %}
protocol lmtp {
  mail_plugins {
    sieve = yes
  }
}
{% endif %}
sieve_script personal {
  driver = file
  path = ~/sieve
  active_path = ~/.dovecot.sieve
}
{% for __dovecot_script_type, __dovecot_source in __dovecot_sieve_scripts.items() if __dovecot_source %}
sieve_script {{ __dovecot_script_type }} {
  type = {{ __dovecot_script_type }}
  driver = file
  path = {{ __dovecot_sieve_source_dir }}/{{ __dovecot_script_type }}.sieve
  bin_path = {{ __dovecot_sieve_cache_dir }}/{{ __dovecot_script_type }}
}
{% endfor %}
{% set __dovecot_reply_extensions = ['vacation', 'reject'] if __dovecot_sieve_has_transport else [] %}
sieve_extensions = {{ (dovecot_sieve_extensions or (__dovecot_sieve_local_extensions + __dovecot_reply_extensions)) | join(' ') | to_json }}
sieve_max_redirects = {{ dovecot_sieve_max_redirects }}
sieve_max_script_size = {{ dovecot_sieve_max_script_size }}B
sieve_quota_script_count = {{ dovecot_sieve_quota_script_count }}
sieve_quota_storage_size = {{ dovecot_sieve_quota_storage_size }}B
{% endif %}
{% if dovecot_spam_learning_enabled %}
{% include '_spam_learning.j2' %}
{% endif %}
