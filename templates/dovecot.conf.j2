# Managed by ansible.
# file: {{ template_destpath }}
{% if __dovecot_version.stdout is version('2.4', '>=') %}
dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0
auth_allow_cleartext = no
auth_username_format = %{user | lower}
mail_driver = {{ dovecot_mail_format }}
mail_path = ~/mail
mail_home = {{ dovecot_mail_root }}/%{user}
{% if dovecot_mail_format == 'mbox' %}
mail_inbox_path = ~/inbox
{% endif %}
passdb passwd-file {
  username_filter = {{ dovecot_users | selectattr('password_hash', 'equalto', '*') | map(attribute='name') | map('regex_replace', '^', '!') | join(' ') }}
  passwd_file_path = /etc/dovecot/users
  result_internalfail = return-fail
}
userdb passwd-file {
  passwd_file_path = /etc/dovecot/users
  result_internalfail = return-fail
}
{% else %}
disable_plaintext_auth = yes
auth_username_format = %Lu
mail_home = {{ dovecot_mail_root }}/%u
mail_location = {{ dovecot_mail_format }}:~/mail{{ ':INBOX=~/inbox' if dovecot_mail_format == 'mbox' else '' }}
passdb {
  driver = passwd-file
  username_filter = {{ dovecot_users | selectattr('password_hash', 'equalto', '*') | map(attribute='name') | map('regex_replace', '^', '!') | join(' ') }}
  args = /etc/dovecot/users
  result_internalfail = return-fail
}
userdb {
  driver = passwd-file
  args = /etc/dovecot/users
  result_internalfail = return-fail
}
{% endif %}
{% if dovecot_sql_enabled %}
{% if __dovecot_version.stdout is version('2.4', '>=') %}
!include /etc/dovecot/sql.conf.ext
{% else %}
{% if dovecot_sql.password_query | length > 0 %}
passdb {
  driver = sql
  args = /etc/dovecot/sql.conf.ext
  result_internalfail = return-fail
}
{% if dovecot_pam_enabled %}
passdb {
  driver = sql
  args = /etc/dovecot/sql.conf.ext
  mechanisms = plain login
  deny = yes
  result_internalfail = return-fail
}
{% endif %}
{% endif %}
{% if dovecot_sql.user_query | length > 0 %}
userdb {
  driver = sql
  args = /etc/dovecot/sql.conf.ext
  result_internalfail = return-fail
}
{% endif %}
{% endif %}
{% endif %}
{% if dovecot_ldap_enabled %}
{% if __dovecot_version.stdout is version('2.4', '>=') %}
!include /etc/dovecot/ldap.conf.ext
{% else %}
userdb {
  driver = ldap
  args = /etc/dovecot/ldap.conf.ext
  result_internalfail = return-fail
}
{% endif %}
{% endif %}
{% if dovecot_sasl_users | length > 0 %}
protocol smtp {
  passdb{{ ' sasl-users' if __dovecot_version.stdout is version('2.4', '>=') else '' }} {
    driver = passwd-file
{% if __dovecot_version.stdout is version('2.4', '>=') %}
    passwd_file_path = /etc/dovecot/sasl-users
    mechanisms_filter = plain login
{% else %}
    args = /etc/dovecot/sasl-users
    mechanisms = plain login
{% endif %}
    username_filter = {{ dovecot_sasl_users | map(attribute='name') | join(' ') }}
    result_failure = return-fail
    result_internalfail = return-fail
  }
}
{% endif %}
{% if dovecot_pam_enabled %}
{% set __dovecot_legacy_pam_mapping = __dovecot_version.stdout is version('2.4', '<') and dovecot_pam_username_format == 'localpart' %}
{% macro __dovecot_pam_filter() -%}
{{ dovecot_pam_username_filter | join(' ') }}{% for __dovecot_account in dovecot_users if __dovecot_account.password_hash != '*' %} !{{ __dovecot_account.name }}{% endfor %}{% for __dovecot_account in dovecot_sasl_users %} !{{ __dovecot_account.name }}{% endfor %}
{%- endmacro %}
{% if dovecot_pam_username_format == 'localpart' %}
# A qualified login is required before domain-restricted local-part mapping.
passdb{{ ' pam-qualified' if __dovecot_version.stdout is version('2.4', '>=') else '' }} {
  driver = static
  deny = yes
  username_filter = !*@*
  {{ 'mechanisms_filter' if __dovecot_version.stdout is version('2.4', '>=') else 'mechanisms' }} = plain login
}
{% endif %}
{% if __dovecot_legacy_pam_mapping %}
# 2.3 workers ignore default_fields; this lookup changes no authentication state.
passdb {
  driver = static
  args = noauthenticate user=%n
  username_filter = {{ __dovecot_pam_filter() }}
  mechanisms = plain login
  result_internalfail = return-fail
}
{% endif %}
passdb{{ ' pam' if __dovecot_version.stdout is version('2.4', '>=') else '' }} {
  driver = pam
  username_filter = {{ '!*@*' if __dovecot_legacy_pam_mapping else __dovecot_pam_filter() }}

{% if __dovecot_version.stdout is version('2.4', '>=') %}
  mechanisms_filter = plain login
  service_name = {{ dovecot_pam_service }}
{% if dovecot_pam_username_format == 'localpart' %}
  fields {
    user = %{user | username}
  }
{% endif %}
{% else %}
  mechanisms = plain login
  args = {{ dovecot_pam_service }}
{% endif %}
  result_success = continue-ok
  result_failure = return-fail
  result_internalfail = return-fail
}
# PAM modules may rewrite PAM_USER; retain the complete mail login identity.
passdb{{ ' pam-identity' if __dovecot_version.stdout is version('2.4', '>=') else '' }} {
  driver = static
  skip = unauthenticated
{% if __dovecot_version.stdout is version('2.4', '>=') %}
  mechanisms_filter = plain login
  fields {
    user = %{original_user | lower}
  }
{% else %}
  mechanisms = plain login
  override_fields = user=%L{original_user}
{% endif %}
}
{% endif %}
{% if dovecot_auth_worker_user | length > 0 %}
service auth-worker {
  user = {{ dovecot_auth_worker_user | to_json }}
}
{% endif %}
{% if dovecot_gssapi_enabled %}
auth_krb5_keytab = {{ dovecot_krb5_keytab | to_json }}
auth_gssapi_hostname = {{ dovecot_gssapi_hostname | to_json }}
{% endif %}
mail_uid = {{ dovecot_mail_uid }}
mail_gid = {{ dovecot_mail_gid }}
hostname = {{ dovecot_hostname | to_json }}
postmaster_address = {{ dovecot_postmaster_address | to_json }}
protocols = lmtp{{ ' imap' if dovecot_imap_enabled else '' }}{{ ' sieve' if dovecot_managesieve_enabled else '' }}
listen = {{ dovecot_listen | join(', ') | to_json }}
auth_mechanisms = plain login{{ ' gssapi' if dovecot_gssapi_enabled else '' }}
first_valid_uid = {{ dovecot_mail_uid }}
last_valid_uid = {{ dovecot_mail_uid }}
first_valid_gid = {{ dovecot_mail_gid }}
last_valid_gid = {{ dovecot_mail_gid }}
mail_privileged_group =
mail_access_groups =
mail_full_filesystem_access = no
{% if dovecot_imap_enabled or dovecot_managesieve_enabled %}
ssl = required
ssl_min_protocol = {{ dovecot_tls_min_protocol }}
{% if __dovecot_version.stdout is version('2.4', '>=') %}
ssl_server_cert_file = {{ dovecot_tls_certificate | to_json }}
ssl_server_key_file = {{ dovecot_tls_private_key | to_json }}
{% else %}
ssl_cert = <{{ dovecot_tls_certificate }}
ssl_key = <{{ dovecot_tls_private_key }}
{% endif %}
{% else %}
ssl = no
{% endif %}
service lmtp {
  unix_listener {{ dovecot_lmtp_socket }} {
    mode = 0600
    user = {{ dovecot_socket_user | to_json }}
    group = {{ dovecot_socket_group | to_json }}
  }
  inet_listener lmtp {
    port = 0
  }
}
service auth {
{% if dovecot_postfix_auth_enabled %}
  unix_listener {{ dovecot_auth_socket }} {
    mode = 0600
    user = {{ dovecot_socket_user | to_json }}
    group = {{ dovecot_socket_group | to_json }}
  }
{% endif %}
}
{% if dovecot_imap_enabled %}
service imap-login {
  inet_listener imap {
    port = 0
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}
{% endif %}
{% if dovecot_managesieve_enabled %}
service managesieve-login {
  inet_listener sieve {
    port = 4190
  }
}
{% endif %}
namespace inbox {
  inbox = yes
  separator = /
  mailbox Drafts {
    special_use = \Drafts
    auto = subscribe
  }
  mailbox Sent {
    special_use = \Sent
    auto = subscribe
  }
  mailbox Junk {
    special_use = \Junk
    auto = subscribe
  }
  mailbox Trash {
    special_use = \Trash
    auto = subscribe
  }
}
{% if dovecot_sieve_enabled %}
protocol lmtp {
  mail_plugins = sieve
}
{% if __dovecot_version.stdout is version('2.4', '>=') %}
sieve_script personal {
  driver = file
  path = ~/sieve
  active_path = ~/.dovecot.sieve
}
{% if dovecot_sieve_before | length > 0 %}
sieve_script before {
  type = before
  driver = file
  path = /etc/dovecot/sieve-before.sieve
}
{% endif %}
sieve_max_redirects = {{ dovecot_sieve_max_redirects }}
sieve_max_script_size = 1M
sieve_quota_script_count = 20
sieve_quota_storage_size = 5M
{% else %}
plugin {
  sieve = file:~/sieve;active=~/.dovecot.sieve
{% if dovecot_sieve_before | length > 0 %}
  sieve_before = /etc/dovecot/sieve-before.sieve
{% endif %}
  sieve_max_redirects = {{ dovecot_sieve_max_redirects }}
  sieve_max_script_size = 1M
  sieve_quota_max_scripts = 20
  sieve_quota_max_storage = 5M
}
{% endif %}
{% endif %}
