{{ ansible_managed | comment(prefix_count=0, postfix_count=0) }}
# file: {{ template_destpath }}
{% for __dovecot_account in dovecot_users %}
{% set __dovecot_format = __dovecot_account.mail_format | default(dovecot_mail_format) %}
{% set __dovecot_fields = ['userdb_mail_driver=' ~ __dovecot_format] %}
{% if __dovecot_account.password_hash == '*' %}
{% set __dovecot_fields = __dovecot_fields + ['noauthenticate'] %}
{% endif %}
{% if __dovecot_format == 'mbox' %}
{% set __dovecot_fields = __dovecot_fields + ['userdb_mail_inbox_path=~/inbox'] %}
{% elif dovecot_mail_format == 'mbox' %}
{% set __dovecot_fields = __dovecot_fields + ['userdb_mail_inbox_path=' ~ ('~/mail' if __dovecot_format == 'maildir' else '~/mail/mailboxes/INBOX/dbox-Mails')] %}
{% endif %}
{% if dovecot_quota_enabled and __dovecot_account.quota_storage_size is defined %}
{% set __dovecot_fields = __dovecot_fields + ['userdb_quota_storage_size=' ~ __dovecot_account.quota_storage_size ~ 'B'] %}
{% endif %}
{{ [
  __dovecot_account.name, __dovecot_account.password_hash,
  __dovecot_account.uid | default(dovecot_mail_uid), __dovecot_account.gid | default(dovecot_mail_gid),
  '', dovecot_mail_root ~ '/' ~ __dovecot_account.name, '', __dovecot_fields | join(' ')
] | join(':') }}
{% endfor %}
