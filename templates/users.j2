# Managed by ansible.
# file: {{ template_destpath }}
{% for __dovecot_account in dovecot_users %}
{% set format = __dovecot_account.mail_format | default(dovecot_mail_format) %}
{% set extra = ['userdb_mail_driver=' ~ format] %}
{% if __dovecot_account.password_hash == '*' %}
{% set extra = extra + ['noauthenticate'] %}
{% endif %}
{% if format == 'mbox' %}
{% set extra = extra + ['userdb_mail_inbox_path=~/inbox'] %}
{% elif dovecot_mail_format == 'mbox' %}
{% set extra = extra + ['userdb_mail_inbox_path=' ~ ('~/mail' if format == 'maildir' else '~/mail/mailboxes/INBOX/dbox-Mails')] %}
{% endif %}
{% if dovecot_quota_enabled and __dovecot_account.quota_storage_size is defined %}
{% set extra = extra + ['userdb_quota_storage_size=' ~ __dovecot_account.quota_storage_size ~ 'B'] %}
{% endif %}
{{ __dovecot_account.name }}:{{ __dovecot_account.password_hash }}:{{ __dovecot_account.uid | default(dovecot_mail_uid) }}:{{ __dovecot_account.gid | default(dovecot_mail_gid) }}::{{ dovecot_mail_root }}/{{ __dovecot_account.name }}::{{ extra | join(' ') }}
{% endfor %}
